{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "overlapSeconds": 0,
    "sleepApplication": false,
    "restartPolicyType": "ALWAYS",
    "restartPolicyMaxRetries": 10,
    "limitOverride": {
      "containers": {
        "cpu": 0.5,
        "memoryBytes": 268435456
      }
    }
  }
}
